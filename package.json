{
  "name": "tour-planner",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "backend": "cd backend && mvn spring-boot:run",
    "dev": "npm run start",
    "start:all": "docker-compose up -d && concurrently --names \"backend,frontend\" --prefix-colors \"yellow,cyan\" \"npm run backend\" \"npm run start\""
  },
  "private": true,
  "packageManager": "npm@11.2.0",
  "dependencies": {
    "@angular/common": "21.2.4",
    "@angular/compiler": "21.2.4",
    "@angular/core": "21.2.4",
    "@angular/forms": "21.2.4",
    "@angular/platform-browser": "21.2.4",
    "bootstrap": "^5.3.8",
    "leaflet": "^1.9.4",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.4",
    "@angular/cli": "21.2.4",
    "@angular/compiler-cli": "21.2.4",
    "@types/leaflet": "^1.9.21",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
